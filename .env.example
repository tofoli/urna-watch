# Copie para .env (nunca versione o .env real) e ajuste.
# O arquivo .env não é lido automaticamente pelo binário; exporte as variáveis
# ou use `docker compose --env-file .env` / `env $(cat .env | xargs) ...`.

# ---------------------------------------------------------------------------
# Eleição monitorada (padrão: 2º turno presidencial de 2026)
# ---------------------------------------------------------------------------
URNA_ELECTION=6258
URNA_CONTEST=1
URNA_UF=br
# URNA_MUNICIPALITY=67458

# ---------------------------------------------------------------------------
# Coleta
# ---------------------------------------------------------------------------
# Mínimo 30s. O SPA oficial atualiza a cada 120s; não reduza sem motivo.
URNA_POLL_INTERVAL=120s
URNA_HTTP_TIMEOUT=20s
URNA_CONFIG_TTL=30m
URNA_MIN_BACKOFF=5s
URNA_MAX_BACKOFF=5m
URNA_MAX_RETRIES=2
URNA_MAX_FAILURES=3
URNA_RETENTION_EVENTS=200

URNA_TSE_BASE_URL=https://resultados.tse.jus.br
URNA_TSE_ENVIRONMENT=oficial

# ---------------------------------------------------------------------------
# Estado e observabilidade
# ---------------------------------------------------------------------------
URNA_STATE_PATH=./data/state.json
URNA_TUI=true
URNA_LOG_LEVEL=info
URNA_LOG_FORMAT=text
# URNA_LOG_FILE=./data/urna-watch.log
# Servidor HTTP opcional: /healthz e /status (sem credenciais)
# URNA_STATUS_ADDR=127.0.0.1:8080

# ---------------------------------------------------------------------------
# Telegram (segredo: use apenas .env local ou secret manager)
# ---------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_BASELINE=true
# Envia um gráfico PNG com a legenda da mensagem (usa sendPhoto)
TELEGRAM_CHARTS=true
# Mapa do Brasil por estado vencedor (27 consultas por atualização, com cache)
TELEGRAM_MAPS=true
TELEGRAM_FAILURE_ALERTS=true
TELEGRAM_RECOVERY_ALERTS=true
TELEGRAM_MAX_ATTEMPTS=8
TELEGRAM_BASE_BACKOFF=5s
